# ── LLM Providers ──────────────────────────────────────────────────────────
# Providers are tried in numbered order. Failover to next when all keys fail.
# Any OpenAI-compatible API works (Gemini, OpenRouter, Bytez, Ollama, vLLM…)
#
# LLM_PROVIDER_ROUTING=failover    # failover | round_robin | random
#
# LLM_PROVIDER_1_NAME=gemini
# LLM_PROVIDER_1_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_PROVIDER_1_MODEL=gemini-2.5-flash
# LLM_PROVIDER_1_KEYS=key1,key2,key3
# LLM_PROVIDER_1_KEY_ROUTING=round_robin   # failover | round_robin | random
#
# LLM_PROVIDER_2_NAME=bytez
# LLM_PROVIDER_2_URL=https://api.bytez.com/models/v2/openai/v1
# LLM_PROVIDER_2_MODEL=Qwen/Qwen3-4B
# LLM_PROVIDER_2_KEYS=bz_key
# LLM_PROVIDER_2_KEY_ROUTING=failover
#
# LLM_PROVIDER_3_NAME=openrouter
# LLM_PROVIDER_3_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER_3_MODEL=openai/gpt-oss-120b:free
# LLM_PROVIDER_3_KEYS=sk-or-v1-...
# LLM_PROVIDER_3_KEY_ROUTING=failover
#
# LLM_PROVIDER_4_NAME=ollama
# LLM_PROVIDER_4_URL=http://localhost:11434/v1
# LLM_PROVIDER_4_MODEL=qwen2.5:7b
# LLM_PROVIDER_4_KEYS=ollama
# LLM_PROVIDER_4_KEY_ROUTING=failover

# CORS: set to 1 to allow all origins (development only)
# CORS_ALLOW_ALL=1
